{
  "$id": "https://grit-scm.com/schemas/resolve/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ResolveEntryObjectId": {
      "description": "One resolved spec in default oid mode (`--json` without ref-name flags).",
      "properties": {
        "full_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "oid": {
          "type": "string"
        },
        "ref_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "size": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "spec": {
          "type": "string"
        }
      },
      "required": [
        "spec",
        "oid",
        "kind",
        "size"
      ],
      "type": "object"
    },
    "ResolveEntryRefName": {
      "description": "One resolved spec in `--abbrev-ref` / `--symbolic-full-name` mode.",
      "properties": {
        "full_ref": {
          "type": "string"
        },
        "ref_display": {
          "type": "string"
        },
        "ref_name": {
          "type": "string"
        },
        "spec": {
          "type": "string"
        }
      },
      "required": [
        "spec",
        "ref_name",
        "full_ref",
        "ref_display"
      ],
      "type": "object"
    },
    "ResolveEntry": {
      "oneOf": [
        {
          "$ref": "#/definitions/ResolveEntryObjectId"
        },
        {
          "$ref": "#/definitions/ResolveEntryRefName"
        }
      ]
    },
    "WarningRecord": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit resolve`.",
  "properties": {
    "results": {
      "items": {
        "$ref": "#/definitions/ResolveEntry"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/definitions/WarningRecord"
      },
      "type": "array"
    }
  },
  "required": [
    "results"
  ],
  "title": "ResolveOutcome",
  "type": "object"
}
