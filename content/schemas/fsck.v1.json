{
  "$id": "https://grit-scm.com/schemas/fsck/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "FsckIssueJson": {
      "properties": {
        "detail": {
          "type": "string"
        },
        "msg_id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        }
      },
      "required": [
        "detail",
        "msg_id",
        "path",
        "severity"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit fsck` / `grit verify`.",
  "properties": {
    "issues": {
      "items": {
        "$ref": "#/definitions/FsckIssueJson"
      },
      "type": "array"
    },
    "ok": {
      "type": "boolean"
    }
  },
  "required": [
    "issues",
    "ok"
  ],
  "title": "FsckOutcome",
  "type": "object"
}
