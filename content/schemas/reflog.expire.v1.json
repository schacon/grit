{
  "$id": "https://grit-scm.com/schemas/reflog.expire/v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "ReflogExpireRefOutcome": {
      "properties": {
        "pruned": {
          "format": "uint",
          "minimum": 0.0,
          "type": "integer"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "pruned",
        "ref"
      ],
      "type": "object"
    }
  },
  "description": "Result of `grit reflog expire`.",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "entries_pruned": {
      "format": "uint",
      "minimum": 0.0,
      "type": "integer"
    },
    "refs": {
      "items": {
        "$ref": "#/definitions/ReflogExpireRefOutcome"
      },
      "type": "array"
    }
  },
  "required": [
    "dry_run",
    "entries_pruned",
    "refs"
  ],
  "title": "ReflogExpireOutcome",
  "type": "object"
